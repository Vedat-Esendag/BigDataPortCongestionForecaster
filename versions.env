# Single source of truth for component versions.
#
# Picked on 2026-10-27 as the latest stable release of each component, looked up in the
# upstream registries (Docker Hub, PyPI, Maven Central, GitHub releases). The reasoning for
# each choice is in docs/decisions.md. These are NOT matched to the course cluster. When the
# cluster versions are known, change them here and nowhere else.
#
# Format: plain KEY=value, no quotes, no inline comments. This file is read by make, by
# docker compose (via the include in infra/docker-compose.yml) and by shell scripts.

# Runtimes
PYTHON_VERSION=3.12
JAVA_VERSION=21
NODE_VERSION=24
UV_VERSION=0.13.6
RUFF_VERSION=0.17.3

# Confluent Platform: Kafka, Schema Registry, Connect, ksqlDB (CP 8.4 ships Apache Kafka 4.4, KRaft only)
CP_VERSION=8.4.0
REDPANDA_CONSOLE_VERSION=v3.13.1
KAFKA_EXPORTER_VERSION=v1.11.0

# Spark (Scala 2.13 builds only; the Kafka and Avro packages must match SPARK_VERSION)
SPARK_VERSION=4.2.0
SPARK_SCALA_VERSION=2.13
SPARK_IMAGE_TAG=4.2.0-scala2.13-java21-python3-ubuntu
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.0
SPARK_AVRO_PACKAGE=org.apache.spark:spark-avro_2.13:4.2.0

# Storage
HADOOP_VERSION=3.5.0
CASSANDRA_VERSION=5.0.9
REDIS_VERSION=8.8.4

# Monitoring
PROMETHEUS_VERSION=v3.15.1
GRAFANA_VERSION=13.2.5

# Kafka Connect plugins (see docs/connectors.md for sources and licenses)
FILEPULSE_VERSION=2.18.0
CAMEL_HTTP_SOURCE_VERSION=4.22.0
HDFS_SINK_VERSION=10.2.17
CASSANDRA_SINK_VERSION=1.7.6
REDIS_SINK_VERSION=1.1.0
LENSES_HTTP_SINK_VERSION=12.1.2

# Kubernetes (Helm charts and operators)
STRIMZI_VERSION=1.3.0
K8SSANDRA_OPERATOR_VERSION=1.33.0
KUBE_PROMETHEUS_STACK_VERSION=92.14.0
