{
  "type": "record",
  "name": "AisHistoryRaw",
  "namespace": "com.sdu.portcongestion",
  "doc": "One row of a Danish Maritime Authority daily CSV, exactly as read by the FilePulse connector (all strings). One DMA row can carry position fields, static fields or both, so ksql/history_split.sql fans this topic out into ais.history.position and ais.history.static. Key: mmsi.",
  "fields": [
    {"name": "timestamp", "type": ["null", "string"], "default": null, "doc": "dd/MM/yyyy HH:mm:ss, UTC. CSV column '# Timestamp'."},
    {"name": "type_of_mobile", "type": ["null", "string"], "default": null},
    {"name": "mmsi", "type": ["null", "string"], "default": null},
    {"name": "latitude", "type": ["null", "string"], "default": null},
    {"name": "longitude", "type": ["null", "string"], "default": null},
    {"name": "navigational_status", "type": ["null", "string"], "default": null},
    {"name": "rot", "type": ["null", "string"], "default": null},
    {"name": "sog", "type": ["null", "string"], "default": null},
    {"name": "cog", "type": ["null", "string"], "default": null},
    {"name": "heading", "type": ["null", "string"], "default": null},
    {"name": "imo", "type": ["null", "string"], "default": null},
    {"name": "callsign", "type": ["null", "string"], "default": null},
    {"name": "name", "type": ["null", "string"], "default": null},
    {"name": "ship_type", "type": ["null", "string"], "default": null},
    {"name": "cargo_type", "type": ["null", "string"], "default": null},
    {"name": "width", "type": ["null", "string"], "default": null},
    {"name": "length", "type": ["null", "string"], "default": null},
    {"name": "position_fixing_device", "type": ["null", "string"], "default": null},
    {"name": "draught", "type": ["null", "string"], "default": null},
    {"name": "destination", "type": ["null", "string"], "default": null},
    {"name": "eta", "type": ["null", "string"], "default": null, "doc": "dd/MM/yyyy HH:mm:ss, includes the year."},
    {"name": "data_source_type", "type": ["null", "string"], "default": null},
    {"name": "a", "type": ["null", "string"], "default": null, "doc": "Distance bow to antenna."},
    {"name": "b", "type": ["null", "string"], "default": null, "doc": "Distance stern to antenna."},
    {"name": "c", "type": ["null", "string"], "default": null, "doc": "Distance port side to antenna."},
    {"name": "d", "type": ["null", "string"], "default": null, "doc": "Distance starboard side to antenna."}
  ]
}
