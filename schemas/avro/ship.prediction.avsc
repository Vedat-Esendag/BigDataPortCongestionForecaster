{
  "type": "record",
  "name": "ShipPrediction",
  "namespace": "com.sdu.portcongestion",
  "doc": "Predicted arrival for one ship at one port. Key: mmsi.",
  "fields": [
    {"name": "mmsi", "type": "long", "doc": "Also the Kafka record key."},
    {"name": "port", "type": "string", "doc": "Destination port id from config/ports.yaml."},
    {"name": "broadcast_eta", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "Crew-typed ETA from AIS."},
    {"name": "predicted_eta", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "eta_lower", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Lower bound of the 70% window."},
    {"name": "eta_upper", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Upper bound of the 70% window."},
    {"name": "model_version", "type": "string", "doc": "Directory name under the HDFS model root, or 'dummy' for the placeholder predictor."},
    {"name": "reason_codes", "type": {"type": "array", "items": "string"}, "default": [], "doc": "Short codes explaining the prediction, for example 'high_wind' or 'slow_approach'."},
    {"name": "lat", "type": ["null", "double"], "default": null, "doc": "Last known position, so the dashboard map needs no second feed."},
    {"name": "lon", "type": ["null", "double"], "default": null},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Event time of the position this prediction is based on."},
    {"name": "processing_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When Spark produced the prediction."},
    {"name": "day", "type": "string", "doc": "UTC date of event_time as yyyy-MM-dd. Cassandra partition column."}
  ]
}
