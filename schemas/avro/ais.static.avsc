{
  "type": "record",
  "name": "AisStatic",
  "namespace": "com.sdu.portcongestion",
  "doc": "Static and voyage data for one ship (AIS message type 5 / ShipStaticData). eta_broadcast is the ETA typed in by the crew, which is the value this system replaces with a predicted ETA.",
  "fields": [
    {"name": "mmsi", "type": "long", "doc": "Also the Kafka record key."},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "received_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "imo", "type": ["null", "long"], "default": null},
    {"name": "call_sign", "type": ["null", "string"], "default": null},
    {"name": "name", "type": ["null", "string"], "default": null},
    {"name": "ship_type", "type": ["null", "int"], "default": null, "doc": "AIS ship and cargo type code."},
    {"name": "length_m", "type": ["null", "double"], "default": null},
    {"name": "beam_m", "type": ["null", "double"], "default": null},
    {"name": "draught_m", "type": ["null", "double"], "default": null},
    {"name": "destination", "type": ["null", "string"], "default": null, "doc": "Free text typed by the crew, often a port name or UN/LOCODE."},
    {"name": "eta_broadcast", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "Crew-typed ETA. AIS carries no year, so live data infers it from event_time."},
    {"name": "source", "type": "string", "default": "aisstream"}
  ]
}
