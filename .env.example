# Copy to .env and fill in. .env is gitignored. Never commit it.
# Component versions live in versions.env, not here.

# --- Secrets (keep empty here) ---
# Free key from https://aisstream.io (sign in with GitHub)
AISSTREAM_API_KEY=
# Free key from the DMI open data portal (needed only for the DMI observation connector)
DMI_API_KEY=
# Where the alert webhook sink POSTs. Any HTTP endpoint, for example a webhook.site URL.
ALERT_WEBHOOK_URL=

# --- Endpoints for processes running on the host (not inside docker compose) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_URL=redis://localhost:6379/0
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=portcongestion

# --- Config file locations (relative to the repo root) ---
PORTS_CONFIG=config/ports.yaml
THRESHOLDS_CONFIG=config/thresholds.yaml
AVRO_SCHEMA_DIR=schemas/avro

# --- Producer behaviour ---
# Metrics endpoint for the AIS producer (Prometheus scrapes /metrics)
PRODUCER_METRICS_PORT=9100
# Set to true to let the producer register schemas itself. Default false: run `make schemas` first.
SCHEMA_AUTO_REGISTER=false

# --- HDFS (data lake root and model root) ---
HDFS_URI=hdfs://localhost:8020
LAKE_ROOT=/lake
MODEL_ROOT=/models/eta
